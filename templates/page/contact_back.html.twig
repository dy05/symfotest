{% extends 'base.html.twig' %}

{% block body %}
    <h1>Contact Us</h1>
    {% include 'parts/flashes.html.twig' %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">{{ form_row(form.name, {label: 'Your name'}) }}</div>
        <div class="col-md-6">{{ form_row(form.email, {label: 'Your email'}) }}</div>
    </div>
    <div class="row">
        <div class="col-md-6">{{ form_row(form.phone, {label: 'Your phone number'}) }}</div>
    </div>
    {{ form_row(form.message, {label: 'Your message'}) }}
    {{ form_row(form.rgpd, {label: "Please accept conditions."}) }}
    <div class="form-group">
        <button class="btn btn-primary" type="submit">Submit</button>
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block title %}

{% endblock %}
